#!/usr/bin/env bash
set -uo pipefail
VERSION="1.12.4"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for f in "$ROOT"/lib/hardware.sh "$ROOT"/lib/memory.sh "$ROOT"/lib/extras.sh "$ROOT"/lib/cu.sh "$ROOT"/lib/gpu_oc.sh "$ROOT"/lib/setup.sh; do
  [ -r "$f" ] && source "$f"
done

if [ -t 1 ] && [ "${NO_COLOR:-}" = "" ]; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_GREEN=$'\033[1;32m'; C_YELLOW=$'\033[1;33m'; C_RED=$'\033[1;31m'; C_CYAN=$'\033[1;36m'
else
  C_RESET=''; C_BOLD=''; C_GREEN=''; C_YELLOW=''; C_RED=''; C_CYAN=''
fi
ok(){ printf '%s[ OK ]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn(){ printf '%s[WARN]%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
info(){ printf '%s[INFO]%s %s\n' "$C_CYAN" "$C_RESET" "$*"; }
die(){ printf '%s[ERR ]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; return 1; }
heading(){ printf '%s%s%s\n' "$C_BOLD" "$*" "$C_RESET"; }
center_line(){ local t="$1" w=64 n l r; n=${#t}; l=$(((w-n)/2)); r=$((w-n-l)); printf '║ %*s%s%*s ║\n' "$l" '' "$t" "$r" ''; }
banner(){ printf '\n╔══════════════════════════════════════════════════════════════════╗\n'; center_line 'CachyOS BC250 Master Toolkit'; center_line 'Platform • Performance • Diagnostics'; center_line "v${VERSION}"; printf '╚══════════════════════════════════════════════════════════════════╝\n'; }
pause_screen(){ printf '\n'; read -r -p 'Press Enter to continue...' _; }

run_privileged(){
  if [ "$EUID" -eq 0 ]; then "$@"; return $?; fi
  command -v sudo >/dev/null 2>&1 || { die 'sudo is required for this operation.'; return 1; }
  sudo -v || { die 'Authorization was cancelled.'; return 1; }
  sudo env BC250_PRIVILEGED=1 "$@"
}

show_preflight(){
  banner; heading '00 — PREFLIGHT / PLATFORM VALIDATION'; echo
  local card h; card=$(bc250_gpu_card 2>/dev/null || true)
  [ -n "$card" ] || { warn 'AMD BC-250 GPU was not detected.'; return 1; }
  h=$(bc250_hwmon "$card" 2>/dev/null || true)
  ok 'AMD BC-250 detected (PCI 1002:13fe).'
  printf '\n  OS              : %s\n  Kernel          : %s\n  BIOS            : %s\n  CPU             : %sC / %sT\n  CPU driver      : %s\n  CPU governor    : %s\n  GPU             : %s\n  GPU SCLK        : %s MHz\n  GPU busy        : %s%%\n  GPU temp        : %s°C\n  CPU temp        : %s°C\n  VRM temp        : %s°C\n\n' \
    "$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-Linux}")" "$(uname -r)" "$(bc250_bios)" \
    "$(bc250_cpu_cores)" "$(bc250_cpu_threads)" "$(bc250_cpu_driver)" "$(bc250_cpu_governor)" "$card" \
    "$(bc250_gpu_sclk "$h")" "$(bc250_gpu_busy "$card")" "$(bc250_gpu_temp "$h")" "$(bc250_cpu_temp)" "$(bc250_vrm_temp)"
  bc250_bios_ok && ok 'BIOS P3.00 detected — BC-250 telemetry profile.' || warn "BIOS $(bc250_bios) — P3.00 recommended."
  bc250_kernel_ok && ok 'CachyOS BC-250 kernel detected.' || warn "Kernel $(uname -r) — BC-250 kernel recommended."
  command -v cpupower >/dev/null 2>&1 && ok 'cpupower available' || warn 'cpupower missing'
  command -v vulkaninfo >/dev/null 2>&1 && ok 'vulkaninfo available' || warn 'vulkaninfo missing'
  [ -x /usr/bin/cyan-skillfish-governor-smu ] && ok 'Cyan-Skillfish binary installed' || warn 'Cyan-Skillfish binary missing'
  [ -f /etc/cyan-skillfish-governor-smu/config.toml ] && ok 'Cyan-Skillfish configuration present' || warn 'Cyan-Skillfish configuration missing'
  bc250_governor_ok && ok 'GPU governor service active' || warn 'GPU governor service inactive'
  bc250_telemetry_ok && ok 'GPU telemetry interfaces available' || warn 'GPU telemetry interfaces incomplete'
  [ -r "/sys/class/drm/$card/device/pp_dpm_sclk" ] && ok 'GPU DPM interface available' || warn 'GPU DPM interface unavailable'
  [ -r "/sys/class/drm/$card/device/mem_info_vram_total" ] && ok 'VRAM telemetry available' || warn 'VRAM telemetry unavailable'
  [ -x /usr/local/bin/bc250-cu-live-manager ] && ok 'CU/WGP manager installed' || warn 'CU/WGP manager missing'
}

toolkit_status(){
  banner; heading 'System Status'; echo
  printf '  BIOS                   %s\n  Kernel                 %s\n  CPU                    %sC / %sT\n  CPU driver             %s\n  CPU governor            %s\n' \
    "$(bc250_bios)" "$(uname -r)" "$(bc250_cpu_cores)" "$(bc250_cpu_threads)" "$(bc250_cpu_driver)" "$(bc250_cpu_governor)"
  local card h vr; card=$(bc250_gpu_card 2>/dev/null || true)
  if [[ "$card" == card* ]]; then
    h=$(bc250_hwmon "$card" 2>/dev/null || true); vr=$(bc250_gpu_vram "$card")
    printf '  GPU                    %s\n  GPU SCLK               %s MHz\n  GPU busy               %s%%\n  GPU temp               %s°C\n  VRAM                   %s/%s MB\n  VRAM MCLK              %s MHz\n' \
      "$card" "$(bc250_gpu_sclk "$h")" "$(bc250_gpu_busy "$card")" "$(bc250_gpu_temp "$h")" "${vr% *}" "${vr#* }" "$(bc250_gpu_mclk "$h")"
  fi
  printf '  CPU temp               %s°C\n  VRM temp               %s°C\n\n' "$(bc250_cpu_temp)" "$(bc250_vrm_temp)"
  bc250_bios_ok && ok 'BIOS: P3.00 recommended firmware' || warn "BIOS: $(bc250_bios) — P3.00 recommended"
  bc250_kernel_ok && ok 'Kernel: BC-250 CachyOS kernel active' || warn "Kernel: $(uname -r) — BC-250 kernel not active"
  bc250_governor_ok && ok 'GPU governor: Cyan-Skillfish SMU ACTIVE' || warn 'GPU governor: inactive'
  [ -x /usr/local/bin/bc250-cu-live-manager ] && ok 'CU/WGP manager: installed' || warn 'CU/WGP manager: missing'
}

gpu_status(){
  banner; heading 'GPU / Cyan-Skillfish Status'; echo
  systemctl is-active --quiet cyan-skillfish-governor-smu.service && printf 'Service                : active\n' || printf 'Service                : inactive\n'
  local card h vr; card=$(bc250_gpu_card 2>/dev/null || true)
  if [[ "$card" == card* ]]; then
    h=$(bc250_hwmon "$card" 2>/dev/null || true); vr=$(bc250_gpu_vram "$card")
    printf 'GPU                    : %s\nGPU SCLK               : %s MHz\nGPU busy               : %s%%\nGPU temp               : %s°C\nVRAM                   : %s/%s MB\nVRAM MCLK              : %s MHz\nCPU temp               : %s°C\nVRM temp               : %s°C\n\n' \
      "$card" "$(bc250_gpu_sclk "$h")" "$(bc250_gpu_busy "$card")" "$(bc250_gpu_temp "$h")" "${vr% *}" "${vr#* }" "$(bc250_gpu_mclk "$h")" "$(bc250_cpu_temp)" "$(bc250_vrm_temp)"
  else
    warn 'BC-250 GPU not detected.'
  fi
  bc250_gpu_oc_status
}

apply_gpu_profile(){
  local profile="$1" rc
  printf '\nApplying GPU profile: %s\n\n' "$profile"
  run_privileged "$ROOT/bc250-master-toolkit" gpu oc apply "$profile"
  rc=$?
  if [ "$rc" -eq 0 ]; then
    ok "GPU profile '$profile' applied successfully."
    printf '\n'; bc250_gpu_oc_status
  else
    warn "GPU profile '$profile' was not applied (exit $rc)."
  fi
  return "$rc"
}
apply_gpu_manual(){
  local f="$1" v="$2" m="$3" rc
  run_privileged "$ROOT/bc250-master-toolkit" gpu oc manual "$f" "$v" "$m"
  rc=$?
  [ "$rc" -eq 0 ] && bc250_gpu_oc_status || warn "Manual GPU OC/UV was not applied (exit $rc)."
  return "$rc"
}
reset_gpu(){
  local rc; run_privileged "$ROOT/bc250-master-toolkit" gpu oc reset; rc=$?
  [ "$rc" -eq 0 ] && ok 'GPU OC/UV configuration reset.' || warn "GPU reset failed (exit $rc)."
  return "$rc"
}

platform_menu(){
  while true; do
    banner; heading 'Platform Setup'; echo
    printf '[ 1]  BIOS                Check recommended P3.00 firmware\n[ 2]  CachyOS Kernel       Install/activate linux-cachyos-bc250\n[ 3]  GPU Governor         Verify Cyan-Skillfish SMU governor\n[ 4]  CU / WGP             Install/update CU/WGP manager\n[ 5]  Preflight            Re-run complete validation\n[ 0]  Back\n\nEnter selection: '
    read -r s
    case "${s,,}" in
      1) bc250_bios_setup_menu_action; pause_screen;;
      2) bc250_kernel_setup_menu_action; pause_screen;;
      3) gpu_status; pause_screen;;
      4) run_privileged "$ROOT/bc250-master-toolkit" cu install; pause_screen;;
      5) show_preflight; pause_screen;;
      0) return;;
    esac
  done
}

performance_menu(){
  while true; do
    banner; heading 'Performance Lab'; echo
    printf 'Performance changes are explicit and validation-first. CPU OC remains\nin the research phase; GPU OC/UV is available through Cyan-Skillfish.\n\n'
    bc250_gpu_oc_status; echo
    heading 'GPU Profiles'; printf '──────────────────────────────────────────────────────────────\n[ 1]  Stock                1850 MHz @ 930 mV\n[ 2]  Balanced             2000 MHz @ 1000 mV\n[ 3]  Aggressive            2100 MHz @ 1025 mV   [EXPERIMENTAL]\n[ 4]  Maximum Experimental  2200 MHz @ 1050 mV   [EXPERIMENTAL]\n[ C]  Custom                Enter MHz / mV / minimum MHz\n[ R]  Reset                 Restore previous GPU configuration\n[ 0]  Back\n\nEnter selection: '
    read -r s
    case "${s,,}" in
      1) apply_gpu_profile stock; pause_screen;;
      2) apply_gpu_profile balanced; pause_screen;;
      3) apply_gpu_profile aggressive; pause_screen;;
      4) apply_gpu_profile maximum-experimental; pause_screen;;
      c)
        read -r -p 'Maximum GPU frequency MHz: ' f
        read -r -p 'Voltage mV: ' v
        read -r -p 'Minimum GPU frequency MHz [600]: ' m
        apply_gpu_manual "$f" "$v" "${m:-600}"; pause_screen;;
      r) reset_gpu; pause_screen;;
      0) return;;
    esac
  done
}

hardware_menu(){
  while true; do
    banner; heading 'Hardware & Telemetry'; echo
    printf '[ 1]  Live Status          CPU / GPU / VRM / VRAM telemetry\n[ 2]  GPU Status           Cyan-Skillfish and GPU telemetry\n[ 3]  Memory / UMA         Current RAM/VRAM split and recommendations\n[ 4]  CU / WGP             Compute-unit state and diagnostics\n[ 5]  CPU Diagnostics      CPU topology, driver and governor\n[ 0]  Back\n\nEnter selection: '
    read -r s
    case "${s,,}" in
      1) toolkit_status; pause_screen;;
      2) gpu_status; pause_screen;;
      3) banner; memory; pause_screen;;
      4) run_privileged "$ROOT/bc250-master-toolkit" cu status; pause_screen;;
      5) banner; heading 'CPU Diagnostics'; printf '\n  Cores                  %s\n  Threads                %s\n  Driver                 %s\n  Governor               %s\n  Current frequency      %s MHz\n  CPU temperature        %s°C\n  VRM temperature        %s°C\n' "$(bc250_cpu_cores)" "$(bc250_cpu_threads)" "$(bc250_cpu_driver)" "$(bc250_cpu_governor)" "$(bc250_cpu_freq)" "$(bc250_cpu_temp)" "$(bc250_vrm_temp)"; pause_screen;;
      0) return;;
    esac
  done
}

extras_menu(){
  while true; do
    banner; heading 'System Extras'; echo
    printf '[ 1]  Enable Swap          Configure swap\n[ 2]  ZRAM -> ZSWAP        Enable ZSWAP and disable systemd zram\n[ 3]  Hide RDSEED Warning  Set boot loglevel=0\n[ 4]  Disable Mitigations  Add mitigations=off to Limine\n[ 5]  CU / WGP + UMR       Compute-unit tools and diagnostics\n[ 6]  Status                Show current extras state\n[ 0]  Back\n\nEnter selection: '
    read -r s
    case "${s,,}" in
      1) run_privileged "$ROOT/bc250-master-toolkit" extras swap enable 16G; pause_screen;;
      2) run_privileged "$ROOT/bc250-master-toolkit" extras zswap enable; pause_screen;;
      3) run_privileged "$ROOT/bc250-master-toolkit" extras rdseed hide; pause_screen;;
      4) run_privileged "$ROOT/bc250-master-toolkit" extras mitigations off; pause_screen;;
      5) run_privileged "$ROOT/bc250-master-toolkit" cu status; pause_screen;;
      6) run_privileged "$ROOT/bc250-master-toolkit" extras status; pause_screen;;
      0) return;;
    esac
  done
}

recovery_menu(){
  while true; do
    banner; heading 'Recovery & Revert'; echo
    printf '[ 1]  Reset GPU OC/UV      Restore saved GPU configuration\n[ 2]  Restore boot config  Restore toolkit backup when available\n[ 3]  Show current status   Diagnose before reverting\n[ 0]  Back\n\nEnter selection: '
    read -r s
    case "${s,,}" in
      1) reset_gpu; pause_screen;;
      2) run_privileged bash -c 'if [ -f /etc/default/limine.orig ]; then cp -a /etc/default/limine.orig /etc/default/limine; command -v limine-update >/dev/null 2>&1 && limine-update || true; echo "Boot configuration restored."; else echo "No boot backup found."; fi'; pause_screen;;
      3) toolkit_status; pause_screen;;
      0) return;;
    esac
  done
}

main_menu(){
  while true; do
    banner
    heading 'Validation'; echo '──────────────────────────────────────────────────────────────'
    printf '[ P]  Preflight             Full read-only platform validation\n\n'
    heading 'Platform'; echo '──────────────────────────────────────────────────────────────'
    printf '[ 1]  Platform Setup        BIOS / kernel / governor / CU-WGP\n[ 2]  Performance Lab       GPU profiles and manual OC/UV\n[ 3]  Hardware & Telemetry  Live measurements and diagnostics\n[ 4]  System Extras         Swap / ZSWAP / RDSEED / mitigations\n[ 5]  Recovery & Revert     Undo supported changes\n\n'
    heading 'System'; echo '──────────────────────────────────────────────────────────────'
    printf '[ S]  Status                Current system summary\n[ U]  Update Toolkit        Update from GitHub checkout\n[ 0]  Exit\n\nEnter selection: '
    read -r s
    case "${s,,}" in
      p) show_preflight; pause_screen;;
      s) toolkit_status; pause_screen;;
      1) platform_menu;;
      2) performance_menu;;
      3) hardware_menu;;
      4) extras_menu;;
      5) recovery_menu;;
      u) info 'Use git pull in the toolkit checkout to update safely.'; pause_screen;;
      0) return;;
    esac
  done
}

usage(){ printf 'CachyOS BC250 Master Toolkit v%s\n\nInteractive: %s\nCommands: preflight | status | gpu | cpu | memory | extras | cu\n' "$VERSION" "$0"; }

case "${1:-menu}" in
  menu) main_menu;;
  preflight) show_preflight;;
  status) toolkit_status;;
  gpu)
    case "${2:-status}" in
      status) gpu_status;;
      oc)
        case "${3:-profiles}" in
          profiles) bc250_gpu_oc_profiles;;
          status) bc250_gpu_oc_status;;
          apply)
            if [ "${BC250_PRIVILEGED:-0}" = 1 ] || [ "$EUID" -eq 0 ]; then
              bc250_gpu_oc_apply "${4:-}"
            else
              run_privileged "$ROOT/bc250-master-toolkit" gpu oc apply "${4:-}"
            fi;;
          manual)
            if [ "${BC250_PRIVILEGED:-0}" = 1 ] || [ "$EUID" -eq 0 ]; then
              bc250_gpu_oc_manual "${4:-}" "${5:-}" "${6:-600}"
            else
              run_privileged "$ROOT/bc250-master-toolkit" gpu oc manual "${4:-}" "${5:-}" "${6:-600}"
            fi;;
          reset)
            if [ "${BC250_PRIVILEGED:-0}" = 1 ] || [ "$EUID" -eq 0 ]; then
              bc250_gpu_oc_reset
            else
              run_privileged "$ROOT/bc250-master-toolkit" gpu oc reset
            fi;;
          *) die 'Unknown GPU OC command.'; exit 1;;
        esac;;
      *) die 'Unknown GPU command.'; exit 1;;
    esac;;
  cpu) banner; printf 'CPU: %sC / %sT\nDriver: %s\nGovernor: %s\nFrequency: %s MHz\n' "$(bc250_cpu_cores)" "$(bc250_cpu_threads)" "$(bc250_cpu_driver)" "$(bc250_cpu_governor)" "$(bc250_cpu_freq)";;
  memory) memory;;
  extras)
    case "${2:-status}" in
      status) extras_status_cmd;;
      swap)
        if [ "${BC250_PRIVILEGED:-0}" = 1 ] || [ "$EUID" -eq 0 ]; then extras_swap_enable "${4:-16G}"; else run_privileged "$ROOT/bc250-master-toolkit" extras swap enable "${4:-16G}"; fi;;
      zswap)
        if [ "${BC250_PRIVILEGED:-0}" = 1 ] || [ "$EUID" -eq 0 ]; then extras_zswap_enable; else run_privileged "$ROOT/bc250-master-toolkit" extras zswap enable; fi;;
      rdseed)
        if [ "${BC250_PRIVILEGED:-0}" = 1 ] || [ "$EUID" -eq 0 ]; then extras_rdseed_hide; else run_privileged "$ROOT/bc250-master-toolkit" extras rdseed hide; fi;;
      mitigations)
        if [ "${BC250_PRIVILEGED:-0}" = 1 ] || [ "$EUID" -eq 0 ]; then extras_mitigations_off; else run_privileged "$ROOT/bc250-master-toolkit" extras mitigations off; fi;;
      *) die 'Unknown extras command.'; exit 1;;
    esac;;
  cu)
    if [ "${BC250_PRIVILEGED:-0}" = 1 ] || [ "$EUID" -eq 0 ]; then
      case "${2:-status}" in
        status) bc250_cu_status;;
        install) bc250_cu_install;;
        *) die 'Unknown CU command.'; exit 1;;
      esac
    else
      run_privileged "$ROOT/bc250-master-toolkit" cu "${2:-status}" "${3:-}"
    fi;;
  help|-h|--help) usage;;
  *) usage; exit 1;;
esac
