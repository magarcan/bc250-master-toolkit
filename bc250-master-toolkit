#!/usr/bin/env bash
set -uo pipefail
VERSION="1.11.1"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for f in "$ROOT"/lib/hardware.sh "$ROOT"/lib/memory.sh "$ROOT"/lib/extras.sh "$ROOT"/lib/cu.sh "$ROOT"/lib/gpu_oc.sh "$ROOT"/lib/setup.sh; do [ -r "$f" ] && source "$f"; done
if [ -t 1 ] && [ "${NO_COLOR:-}" = "" ]; then C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_GREEN=$'\033[1;32m'; C_YELLOW=$'\033[1;33m'; C_RED=$'\033[1;31m'; C_CYAN=$'\033[1;36m'; else C_RESET=''; C_BOLD=''; C_GREEN=''; C_YELLOW=''; C_RED=''; C_CYAN=''; fi
center_line(){ local text="$1" width=64 len left right; len=${#text}; ((len>width)) && text=${text:0:width} && len=${#text}; left=$(((width-len)/2)); right=$((width-len-left)); printf '║ %*s%s%*s ║\n' "$left" '' "$text" "$right" ''; }
banner(){ printf '\n╔══════════════════════════════════════════════════════════════════╗\n'; center_line 'CachyOS BC250 Toolkit'; center_line 'System Setup & Configuration'; center_line "v${VERSION}"; printf '╚══════════════════════════════════════════════════════════════════╝\n\n'; }
ok(){ printf '%s[ OK ]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }; warn(){ printf '%s[WARN]%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }; info(){ printf '%s[INFO]%s %s\n' "$C_CYAN" "$C_RESET" "$*"; }; die(){ printf '%s[ERR ]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }; heading(){ printf '%s%s%s\n' "$C_BOLD" "$*" "$C_RESET"; }
root_action(){ case "${2:-}" in kernel-install) bc250_kernel_install;; gpu-oc-apply) bc250_gpu_oc_apply "${3:-}";; gpu-oc-manual) bc250_gpu_oc_manual "${3:-}" "${4:-}" "${5:-}";; gpu-oc-reset) bc250_gpu_oc_reset;; esac; }
status(){ banner; heading 'System Status'; echo; printf '  BIOS                   %s\n  Kernel                 %s\n  CPU                    %sC / %sT\n  CPU driver             %s\n  CPU governor           %s\n' "$(bc250_bios)" "$(uname -r)" "$(bc250_cpu_cores)" "$(bc250_cpu_threads)" "$(bc250_cpu_driver)" "$(bc250_cpu_governor)"; local card h vr; card=$(bc250_gpu_card 2>/dev/null || true); if [[ "$card" == card* ]]; then h=$(bc250_hwmon "$card" 2>/dev/null || true); vr=$(bc250_gpu_vram "$card"); printf '  GPU                    %s\n  GPU SCLK               %s MHz\n  GPU busy               %s%%\n  GPU temp               %s°C\n  VRAM                   %s/%s MB\n  VRAM MCLK              %s MHz\n' "$card" "$(bc250_gpu_sclk "$h")" "$(bc250_gpu_busy "$card")" "$(bc250_gpu_temp "$h")" "${vr% *}" "${vr#* }" "$(bc250_gpu_mclk "$h")"; fi; printf '  CPU temp               %s°C\n  VRM temp               %s°C\n\n' "$(bc250_cpu_temp)" "$(bc250_vrm_temp)"; bc250_bios_ok && ok 'BIOS: P3.00 recommended firmware' || warn "BIOS: $(bc250_bios) — P3.00 recommended"; bc250_kernel_ok && ok 'Kernel: BC-250 CachyOS kernel active' || warn "Kernel: $(uname -r) — BC-250 kernel not active"; bc250_governor_ok && ok 'GPU governor: Cyan-Skillfish SMU ACTIVE' || warn 'GPU governor: inactive'; [ -x /usr/local/bin/bc250-cu-live-manager ] && ok 'CU/WGP manager: installed' || warn 'CU/WGP manager: missing'; }
preflight(){ banner; heading '== 00 — PREFLIGHT (READ-ONLY) =='; echo; local card h; card=$(bc250_gpu_card 2>/dev/null || true); [ -n "$card" ] || die 'AMD BC-250 GPU was not detected.'; h=$(bc250_hwmon "$card" 2>/dev/null || true); ok 'AMD BC-250 detected (PCI 1002:13fe).'; printf '\n  OS              : %s\n  Kernel          : %s\n  BIOS            : %s\n  CPU             : %sC / %sT\n  CPU driver      : %s\n  CPU governor    : %s\n  GPU             : %s\n  GPU SCLK        : %s MHz\n  GPU busy        : %s%%\n  GPU temp        : %s°C\n  CPU temp        : %s°C\n  VRM temp        : %s°C\n\n' "$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-Linux}")" "$(uname -r)" "$(bc250_bios)" "$(bc250_cpu_cores)" "$(bc250_cpu_threads)" "$(bc250_cpu_driver)" "$(bc250_cpu_governor)" "$card" "$(bc250_gpu_sclk "$h")" "$(bc250_gpu_busy "$card")" "$(bc250_gpu_temp "$h")" "$(bc250_cpu_temp)" "$(bc250_vrm_temp)"; bc250_bios_ok && ok 'BIOS P3.00 detected — BC-250 telemetry profile.' || warn "BIOS $(bc250_bios) — P3.00 recommended; see Initial Setup."; bc250_kernel_ok && ok 'CachyOS BC-250 kernel detected.' || warn "Kernel $(uname -r) — BC-250 kernel recommended; see Initial Setup."; command -v cpupower >/dev/null 2>&1 && ok 'cpupower available' || warn 'cpupower missing'; command -v vulkaninfo >/dev/null 2>&1 && ok 'vulkaninfo available' || warn 'vulkaninfo missing'; [ -x /usr/bin/cyan-skillfish-governor-smu ] && ok 'Cyan-Skillfish binary installed' || warn 'Cyan-Skillfish binary missing'; [ -f /etc/cyan-skillfish-governor-smu/config.toml ] && ok 'Cyan-Skillfish configuration present' || warn 'Cyan-Skillfish configuration missing'; bc250_governor_ok && ok 'GPU governor service active' || warn 'GPU governor service inactive'; bc250_telemetry_ok && ok 'GPU telemetry interfaces available' || warn 'GPU telemetry interfaces incomplete'; [ -r "/sys/class/drm/$card/device/pp_dpm_sclk" ] && ok 'GPU DPM interface available' || warn 'GPU DPM interface unavailable'; [ -r "/sys/class/drm/$card/device/mem_info_vram_total" ] && ok 'VRAM telemetry available' || warn 'VRAM telemetry unavailable'; [ -x /usr/local/bin/bc250-cu-live-manager ] && ok 'CU/WGP manager installed' || warn 'CU/WGP manager missing'; }
additional_tools(){ while true; do banner; heading 'Additional Tools'; echo; printf '[ 1]  Enable Swap          Configure system swap\n[ 2]  ZRAM -> ZSWAP        Enable ZSWAP and disable systemd zram\n[ 3]  Hide RDSEED Warning  Set boot loglevel=0\n[ 4]  Disable Mitigations  Add mitigations=off to Limine\n[ 5]  CU/WGP + UMR          Compute-unit tools and diagnostics\n[ 0]  Back\n\nEnter selection: '; read -r s; case "${s,,}" in 1) sudo -v && sudo "$0" extras swap enable 16G;; 2) sudo -v && sudo "$0" extras zswap enable;; 3) sudo -v && sudo "$0" extras rdseed hide;; 4) sudo -v && sudo "$0" extras mitigations off;; 5) sudo -v && sudo "$0" cu status;; 0) return;; esac; done; }
revert_menu(){ while true; do banner; heading 'Revert Menu'; echo; printf '[ 1]  Reset GPU OC/UV    Restore saved Cyan-Skillfish configuration\n[ 0]  Back\n\nEnter selection: '; read -r s; case "${s,,}" in 1) sudo -v && sudo "$0" gpu oc reset; read -r -p 'Press Enter to continue...' _;; 0) return;; esac; done; }
performance_menu(){ while true; do banner; heading 'Performance Profiles'; echo; bc250_gpu_oc_status 2>/dev/null || true; echo; printf '[ 1]  Stock\n[ 2]  Balanced\n[ 3]  Aggressive\n[ 4]  Maximum Experimental\n[ C]  Custom GPU OC/UV\n[ 0]  Back\n\nEnter selection: '; read -r s; case "${s,,}" in 1) sudo -v && sudo "$0" gpu oc apply stock;; 2) sudo -v && sudo "$0" gpu oc apply balanced;; 3) sudo -v && sudo "$0" gpu oc apply aggressive;; 4) sudo -v && sudo "$0" gpu oc apply maximum-experimental;; c) read -r -p 'Maximum GPU MHz: ' f; read -r -p 'Voltage mV: ' v; read -r -p 'Minimum GPU MHz [600]: ' m; sudo -v && sudo "$0" gpu oc manual "$f" "$v" "${m:-600}";; 0) return;; esac; done; }
initial_setup(){ while true; do banner; heading 'Initial Setup'; echo; printf 'Configure the core BC-250 platform components.\n\n[ 1]  BIOS Recommendation  Recommended P3.00 firmware and instructions\n[ 2]  CachyOS Kernel        Install linux-cachyos-bc250 + headers\n[ 3]  GPU Governor          Verify Cyan-Skillfish governor\n[ 4]  CU/WGP Manager        Install/update CU/WGP live manager\n[ 0]  Back\n\nEnter selection: '; read -r s; case "${s,,}" in 1) bc250_bios_setup_menu_action;; 2) bc250_kernel_setup_menu_action;; 3) gpu_status; read -r -p 'Press Enter to continue...' _;; 4) sudo -v && sudo "$0" cu install; read -r -p 'Press Enter to continue...' _;; 0) return;; esac; done; }
main_menu(){ while true; do banner; heading 'Performance'; echo '──────────────────────────────────────────────────────────────'; printf '[ 1]  Performance Profiles  CPU & GPU performance profiles\n\n'; heading 'Setup'; echo '──────────────────────────────────────────────────────────────'; printf '[ 2]  Initial Setup         Core platform setup\n[ 3]  Additional Tools      Optional system utilities\n[ 4]  Revert Menu            Undo supported settings\n\n'; heading 'System'; echo '──────────────────────────────────────────────────────────────'; printf '[ P]  Preflight             Full read-only platform validation\n[ S]  Status                Current system summary\n[ U]  Update Toolkit        Download latest version from GitHub\n[ 0]  Exit\n\nEnter selection: '; read -r s; case "${s,,}" in 1) performance_menu;; 2) initial_setup;; 3) additional_tools;; 4) revert_menu;; p) preflight; read -r -p 'Press Enter to continue...' _;; s) status; read -r -p 'Press Enter to continue...' _;; u) info 'Update is performed from the GitHub checkout with git pull.'; read -r -p 'Press Enter to continue...' _;; 0) clear 2>/dev/null || true; return;; esac; done; }
usage(){ cat <<EOF
BC-250 MASTER TOOLKIT v$VERSION
Usage: $0 [menu|preflight|status|cpu|memory|gpu|extras|cu]
EOF
}
cmd="${1:-menu}"
case "$cmd" in
 menu) main_menu;; __root) root_action "$@";; preflight) preflight;; status) status;; cpu) banner; heading 'CPU / ACPI status'; printf '  Topology               %sC / %sT\n  Driver                 %s\n  Governor               %s\n  CPU 0 current          %s MHz\n  CPU temperature        %s°C\n  VRM temperature        %s°C\n' "$(bc250_cpu_cores)" "$(bc250_cpu_threads)" "$(bc250_cpu_driver)" "$(bc250_cpu_governor)" "$(bc250_cpu_freq)" "$(bc250_cpu_temp)" "$(bc250_vrm_temp)";; memory) memory;; gpu) case "${2:-status}" in status) gpu_status;; oc) case "${3:-profiles}" in profiles) bc250_gpu_oc_profiles;; status) bc250_gpu_oc_status;; apply) bc250_setup_require_root gpu-oc-apply "${4:-}";; manual) bc250_setup_require_root gpu-oc-manual "${4:-}" "${5:-}" "${6:-}";; reset) bc250_setup_require_root gpu-oc-reset;; esac;; esac;; extras) case "${2:-status}" in status) extras_status_cmd;; swap) [ "$EUID" -eq 0 ] || { sudo -v && exec sudo "$0" "$@"; }; [ "${3:-}" = enable ] && bc250_swap_enable "${4:-16G}";; zswap) [ "$EUID" -eq 0 ] || { sudo -v && exec sudo "$0" "$@"; }; [ "${3:-}" = enable ] && bc250_zswap_enable;; rdseed) [ "$EUID" -eq 0 ] || { sudo -v && exec sudo "$0" "$@"; }; [ "${3:-}" = hide ] && bc250_rdseed_hide;; mitigations) [ "$EUID" -eq 0 ] || { sudo -v && exec sudo "$0" "$@"; }; [ "${3:-}" = off ] && bc250_set_cmdline_flag mitigations=off && bc250_update_boot;; esac;; cu) [ "$EUID" -eq 0 ] || { sudo -v && exec sudo "$0" "$@"; }; case "${2:-status}" in status) bc250_cu_status;; install) bc250_cu_install;; umr) [ "${3:-}" = install ] && bc250_umr_install;; esac;; help|-h|--help) usage;; *) usage;; esac
