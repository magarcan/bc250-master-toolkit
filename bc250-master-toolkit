#!/usr/bin/env bash
set -uo pipefail
VERSION="1.13.3"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for f in "$ROOT"/lib/hardware.sh "$ROOT"/lib/memory.sh "$ROOT"/lib/extras.sh "$ROOT"/lib/cu.sh "$ROOT"/lib/gpu_oc.sh "$ROOT"/lib/setup.sh "$ROOT"/lib/ui.sh; do
  [ -r "$f" ] && source "$f"
done
[ -r "$ROOT/lib/ui_refinements.sh" ] && source "$ROOT/lib/ui_refinements.sh"
[ -r "$ROOT/lib/ui_main.sh" ] && source "$ROOT/lib/ui_main.sh"
[ -r "$ROOT/lib/gpu_governor.sh" ] && source "$ROOT/lib/gpu_governor.sh"
[ -r "$ROOT/lib/ui_gui.sh" ] && source "$ROOT/lib/ui_gui.sh"
[ -r "$ROOT/lib/ui_gui_refinements.sh" ] && source "$ROOT/lib/ui_gui_refinements.sh"

# If Preflight finds only the GPU governor service/backend missing, Y means
# "repair it now" rather than merely opening a menu and waiting for another
# selection. Other missing components keep the existing assisted menu.
if declare -F ui_preflight_install_menu >/dev/null 2>&1; then
  eval "$(declare -f ui_preflight_install_menu | sed '1s/^ui_preflight_install_menu /ui_preflight_install_menu_original /')"
  ui_preflight_install_menu() {
    local missing=()
    bc250_bios_ok || missing+=("BIOS P3.00")
    bc250_kernel_ok || missing+=("CachyOS BC-250 kernel")
    command -v cpupower >/dev/null 2>&1 || missing+=("cpupower")
    command -v vulkaninfo >/dev/null 2>&1 || missing+=("vulkaninfo")
    [ -x /usr/bin/cyan-skillfish-governor-smu ] || missing+=("Cyan-Skillfish governor")
    [ -f /etc/cyan-skillfish-governor-smu/config.toml ] || missing+=("Cyan-Skillfish configuration")
    bc250_governor_ok || missing+=("Cyan-Skillfish service")
    bc250_telemetry_ok || missing+=("GPU telemetry")
    local card; card=$(bc250_gpu_card 2>/dev/null || true)
    [ -r "/sys/class/drm/$card/device/pp_dpm_sclk" ] || missing+=("GPU DPM")
    [ -r "/sys/class/drm/$card/device/mem_info_vram_total" ] || missing+=("VRAM telemetry")
    [ -x /usr/local/bin/bc250-cu-live-manager ] || missing+=("CU/WGP manager")
    bc250_umr_present || missing+=("UMR")

    if [ "${#missing[@]}" -eq 1 ] && [ "${missing[0]}" = "Cyan-Skillfish service" ]; then
      heading 'Automatic repair'
      info 'GPU governor service is the only missing component.'
      ui_require_root gpu governor ensure
      local rc=$?
      if [ "$rc" -eq 0 ]; then
        ok 'GPU governor repair completed.'
        ui_pause
        ui_preflight
      else
        die 'GPU governor repair failed.'
        ui_pause
      fi
      return "$rc"
    fi

    ui_preflight_install_menu_original
  }
fi

if [ "${1:-}" = "--gui" ]; then
  shift
  if command -v yad >/dev/null 2>&1 && ! yad --help-all 2>&1 | grep -q -- '--markup'; then
    yad() {
      local arg
      local -a filtered=()
      for arg in "$@"; do
        [ "$arg" = "--markup" ] || filtered+=("$arg")
      done
      command yad "${filtered[@]}"
    }
  fi
  if ! declare -F bc250_gui_main >/dev/null 2>&1; then
    printf '%s\n' 'GUI startup error: bc250_gui_main is not available.' >&2
    exit 1
  fi
  bc250_gui_main "$@"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    printf 'GUI exited with status %s. Run with BC250_GUI_DEBUG=1 for diagnostics.\n' "$rc" >&2
  fi
  exit "$rc"
fi

# All privileged UI actions enter through this dispatcher. Keeping the
# complete action tuple here prevents fall-through into the normal UI parser.
if [ "${1:-}" = "__root" ]; then
  [ "$EUID" -eq 0 ] || { die 'Internal root dispatcher called without root privileges.'; exit 1; }
  shift
  case "${1:-}" in
    kernel-install) bc250_kernel_install;;
    gpu-governor-ensure) bc250_gpu_governor_ensure_kernel_backend;;
    gpu)
      case "${2:-}" in
        oc)
          case "${3:-}" in
            apply) bc250_gpu_oc_apply "${4:-}";;
            manual) bc250_gpu_oc_manual "${4:-}" "${5:-}" "${6:-}";;
            reset) bc250_gpu_oc_reset;;
            *) die "Unknown privileged GPU OC action: ${3:-}"; exit 1;;
          esac
          ;;
        governor)
          [ "${3:-}" = ensure ] && bc250_gpu_governor_ensure_kernel_backend || { die "Unknown privileged GPU governor action: ${3:-}"; exit 1; }
          ;;
        *) die "Unknown privileged GPU action: ${2:-}"; exit 1;;
      esac
      ;;
    extras)
      case "${2:-}" in
        swap) [ "${3:-}" = enable ] && bc250_swap_enable "${4:-16G}" || { die "Unknown privileged swap action: ${3:-}"; exit 1; };;
        zswap) [ "${3:-}" = enable ] && bc250_zswap_enable || { die "Unknown privileged zswap action: ${3:-}"; exit 1; };;
        rdseed) [ "${3:-}" = hide ] && bc250_rdseed_hide || { die "Unknown privileged RDSEED action: ${3:-}"; exit 1; };;
        mitigations) [ "${3:-}" = off ] && bc250_set_cmdline_flag mitigations=off && bc250_update_boot || { die "Unknown privileged mitigations action: ${3:-}"; exit 1; };;
        *) die "Unknown privileged extras action: ${2:-}"; exit 1;;
      esac
      ;;
    cu)
      case "${2:-}" in
        install) bc250_cu_install;;
        umr) [ "${3:-}" = install ] && bc250_umr_install || { die "Unknown privileged UMR action: ${3:-}"; exit 1; };;
        status) bc250_cu_status;;
        *) die "Unknown privileged CU action: ${2:-}"; exit 1;;
      esac
      ;;
    umr-install) bc250_umr_install;;
    cu-install) bc250_cu_install;;
    *) die "Unknown internal setup action: ${1:-}"; exit 1;;
  esac
  exit $?
fi

bc250_ui_main "$@"
