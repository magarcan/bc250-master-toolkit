#!/usr/bin/env bash
set -uo pipefail
VERSION="1.11.0"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for f in "$ROOT"/lib/hardware.sh "$ROOT"/lib/memory.sh "$ROOT"/lib/extras.sh "$ROOT"/lib/cu.sh "$ROOT"/lib/gpu_oc.sh "$ROOT"/lib/setup.sh; do [ -r "$f" ] && source "$f"; done
if [ -t 1 ] && [ "${NO_COLOR:-}" = "" ]; then C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_GREEN=$'\033[1;32m'; C_YELLOW=$'\033[1;33m'; C_RED=$'\033[1;31m'; C_CYAN=$'\033[1;36m'; else C_RESET=''; C_BOLD=''; C_GREEN=''; C_YELLOW=''; C_RED=''; C_CYAN=''; fi
center_line(){ local text="$1" width=64 len left right; len=${#text}; (( len > width )) && text=${text:0:width} && len=${#text}; left=$(( (width-len)/2 )); right=$(( width-len-left )); printf '║ %*s%s%*s ║\n' "$left" '' "$text" "$right" ''; }
banner(){ printf '\n╔══════════════════════════════════════════════════════════════════╗\n'; center_line 'CachyOS BC250 Toolkit'; center_line 'System Setup & Configuration'; center_line "v${VERSION}"; printf '╚══════════════════════════════════════════════════════════════════╝\n\n'; }
ok(){ printf '%s[ OK ]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }; warn(){ printf '%s[WARN]%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }; info(){ printf '%s[INFO]%s %s\n' "$C_CYAN" "$C_RESET" "$*"; }; die(){ printf '%s[ERR ]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }; heading(){ printf '%s%s%s\n' "$C_BOLD" "$*" "$C_RESET"; }
root_action(){ case "${2:-}" in kernel-install) bc250_kernel_install;; esac; }
status(){ banner; heading 'System Status'; echo; printf '  BIOS                   %s\n  Kernel                 %s\n  CPU                    %sC / %sT\n  CPU driver             %s\n  CPU governor           %s\n' "$(bc250_bios)" "$(uname -r)" "$(bc250_cpu_cores)" "$(bc250_cpu_threads)" "$(bc250_cpu_driver)" "$(bc250_cpu_governor)"; local card h vr; card=$(bc250_gpu_card 2>/dev/null || true); if [[ "$card" == card* ]]; then h=$(bc250_hwmon "$card" 2>/dev/null || true); vr=$(bc250_gpu_vram "$card"); printf '  GPU                    %s\n  GPU SCLK               %s MHz\n  GPU busy               %s%%\n  GPU temp               %s°C\n  VRAM                   %s/%s MB\n  VRAM MCLK              %s MHz\n' "$card" "$(bc250_gpu_sclk "$h")" "$(bc250_gpu_busy "$card")" "$(bc250_gpu_temp "$h")" "${vr% *}" "${vr#* }" "$(bc250_gpu_mclk "$h")"; fi; printf '  CPU temp               %s°C\n  VRM temp               %s°C\n\n' "$(bc250_cpu_temp)" "$(bc250_vrm_temp)"; bc250_bios_ok && ok 'BIOS: P3.00 recommended firmware' || warn "BIOS: $(bc250_bios) — P3.00 recommended"; bc250_kernel_ok && ok 'Kernel: BC-250 CachyOS kernel active' || warn "Kernel: $(uname -r) — BC-250 kernel not active"; bc250_governor_ok && ok 'GPU governor: Cyan-Skillfish SMU ACTIVE' || warn 'GPU governor: inactive'; [ -x /usr/local/bin/bc250-cu-live-manager ] && ok 'CU/WGP manager: installed' || warn 'CU/WGP manager: missing'; }
preflight(){ status; echo; heading 'Platform checks'; bc250_platform_status_lines; }
initial_setup(){ while true; do banner; heading 'Initial Setup'; echo 'Configure the BC-250 in a guided, confirmation-first workflow.'; echo; printf '[ 1]  BIOS Recommendation   Recommended P3.00 firmware and project instructions\n[ 2]  CachyOS Kernel         Install linux-cachyos-bc250 + headers\n[ 3]  GPU Governor           Cyan-Skillfish GPU governor service\n[ 4]  Enable Swap            Configure swap\n[ 5]  ZRAM -> ZSWAP          Enable ZSWAP and disable systemd zram\n[ 6]  Hide RDSEED Warning    Set loglevel=0\n[ 7]  Disable Mitigations    Add mitigations=off\n[ A]  Run All                Run applicable software setup tasks\n\n[ 0]  Back\n\n'; printf 'Enter selection: '; read -r s; case "${s,,}" in 1) bc250_bios_setup_menu_action;; 2) bc250_kernel_setup_menu_action;; 3) info 'GPU governor setup remains available through the existing service installer/workflow.'; read -r -p 'Press Enter to continue...' _;; 4) if [ "$EUID" -eq 0 ]; then bc250_swap_enable 16G; else sudo -v && sudo "$0" extras swap enable; fi;; 5) if [ "$EUID" -eq 0 ]; then bc250_zswap_enable; else sudo -v && sudo "$0" extras zswap enable; fi;; 6) if [ "$EUID" -eq 0 ]; then bc250_rdseed_hide; else sudo -v && sudo "$0" extras rdseed hide; fi;; 7) if [ "$EUID" -eq 0 ]; then bc250_set_cmdline_flag mitigations=off; bc250_update_boot; else sudo -v && sudo "$0" extras mitigations off; fi;; a) info 'Run All: BIOS is user-installed; kernel will ask confirmation; software tasks follow their existing implementations.'; bc250_kernel_setup_menu_action; read -r -p 'Press Enter to continue...' _;; 0) return;; esac; done; }
performance_menu(){ while true; do banner; heading 'Performance Profiles'; echo; printf 'GPU profiles are applied through the validated Cyan-Skillfish configuration.\n\n'; bc250_gpu_oc_status 2>/dev/null || true; echo; printf '[ 1]  Stock\n[ 2]  Balanced\n[ 3]  Aggressive\n[ 4]  Maximum Experimental\n[ C]  Custom GPU OC/UV\n[ 0]  Back\n\nEnter selection: '; read -r s; case "${s,,}" in 1) bc250_gpu_oc_apply stock;; 2) bc250_gpu_oc_apply balanced;; 3) bc250_gpu_oc_apply aggressive;; 4) bc250_gpu_oc_apply maximum-experimental;; c) printf 'Max MHz: '; read -r f; printf 'Voltage mV: '; read -r v; bc250_setup_require_root gpu-oc-manual "$f" "$v";; 0) return;; esac; done; }
main_menu(){ while true; do banner; heading 'Performance'; echo '──────────────────────────────────────────────────────────────'; printf '[ 1]  Performance Profiles  CPU & GPU performance profiles\n\n'; heading 'Setup'; echo '──────────────────────────────────────────────────────────────'; printf '[ 2]  Initial Setup         System configuration tasks\n[ 3]  Additional Tools      System utilities\n[ 4]  Revert Menu            Undo supported settings\n\n'; heading 'System'; echo '──────────────────────────────────────────────────────────────'; printf '[ S]  Status                Current system summary\n[ U]  Update Toolkit        Download latest version from GitHub\n[ 0]  Exit\n\nEnter selection: '; read -r s; case "${s,,}" in 1) performance_menu;; 2) initial_setup;; 3) extras_status_cmd;; 4) info 'Revert options remain in the existing subsystem commands.'; read -r -p 'Press Enter to continue...' _;; s) status; read -r -p 'Press Enter to continue...' _;; u) info 'Use git pull from the toolkit checkout to update safely.'; read -r -p 'Press Enter to continue...' _;; 0) clear 2>/dev/null || true; return;; esac; done; }
usage(){ cat <<EOF
BC-250 MASTER TOOLKIT v$VERSION
Usage: $0 [menu|preflight|status|cpu|gpu ...]
EOF
}
cmd="${1:-menu}"
case "$cmd" in
 menu) main_menu;; __root) root_action "$@";; preflight) preflight;; status) status;; cpu) banner; heading 'CPU / ACPI status'; printf '  Topology               %sC / %sT\n  Driver                 %s\n  Governor               %s\n  CPU 0 current          %s MHz\n  CPU temperature        %s°C\n  VRM temperature        %s°C\n' "$(bc250_cpu_cores)" "$(bc250_cpu_threads)" "$(bc250_cpu_driver)" "$(bc250_cpu_governor)" "$(bc250_cpu_freq)" "$(bc250_cpu_temp)" "$(bc250_vrm_temp)";; memory) memory;; gpu) case "${2:-status}" in status) gpu_status;; oc) case "${3:-profiles}" in profiles) bc250_gpu_oc_profiles;; status) bc250_gpu_oc_status;; apply) bc250_setup_require_root gpu-oc-apply "${4:-}";; manual) bc250_setup_require_root gpu-oc-manual "${4:-}" "${5:-}" "${6:-}";; reset) bc250_setup_require_root gpu-oc-reset;; esac;; esac;; extras) case "${2:-status}" in status) extras_status_cmd;; swap) [ "$EUID" -eq 0 ] || { sudo -v && exec sudo "$0" "$@"; }; [ "${3:-}" = enable ] && bc250_swap_enable "${4:-16G}";; zswap) [ "$EUID" -eq 0 ] || { sudo -v && exec sudo "$0" "$@"; }; [ "${3:-}" = enable ] && bc250_zswap_enable;; rdseed) [ "$EUID" -eq 0 ] || { sudo -v && exec sudo "$0" "$@"; }; [ "${3:-}" = hide ] && bc250_rdseed_hide;; mitigations) [ "$EUID" -eq 0 ] || { sudo -v && exec sudo "$0" "$@"; }; [ "${3:-}" = off ] && bc250_set_cmdline_flag mitigations=off && bc250_update_boot;; esac;; cu) [ "$EUID" -eq 0 ] || { sudo -v && exec sudo "$0" "$@"; }; case "${2:-status}" in status) bc250_cu_status;; install) bc250_cu_install;; umr) [ "${3:-}" = install ] && bc250_umr_install;; esac;; help|-h|--help) usage;; *) usage;; esac
