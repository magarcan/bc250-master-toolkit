#!/usr/bin/env bash
set -uo pipefail
VERSION="1.13.1"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for f in "$ROOT"/lib/hardware.sh "$ROOT"/lib/memory.sh "$ROOT"/lib/extras.sh "$ROOT"/lib/cu.sh "$ROOT"/lib/gpu_oc.sh "$ROOT"/lib/setup.sh "$ROOT"/lib/ui.sh; do
  [ -r "$f" ] && source "$f"
done
[ -r "$ROOT/lib/ui_refinements.sh" ] && source "$ROOT/lib/ui_refinements.sh"
[ -r "$ROOT/lib/ui_main.sh" ] && source "$ROOT/lib/ui_main.sh"
[ -r "$ROOT/lib/ui_gui.sh" ] && source "$ROOT/lib/ui_gui.sh"

if [ "${1:-}" = "--gui" ]; then
  shift

  # YAD enables Pango markup in dialog text by default. Some versions reject
  # the legacy/unsupported explicit --markup flag. Strip it transparently so
  # the GUI layer stays compatible across YAD releases without touching the
  # backend or duplicating any hardware logic.
  if command -v yad >/dev/null 2>&1 && ! yad --help-all 2>&1 | grep -q -- '--markup'; then
    yad() {
      local arg
      local -a filtered=()
      for arg in "$@"; do
        [ "$arg" = "--markup" ] || filtered+=("$arg")
      done
      command yad "${filtered[@]}"
    }
  fi

  if ! declare -F bc250_gui_main >/dev/null 2>&1; then
    printf '%s\n' 'GUI startup error: bc250_gui_main is not available.' >&2
    exit 1
  fi

  bc250_gui_main "$@"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    printf 'GUI exited with status %s. Run with BC250_GUI_DEBUG=1 for diagnostics.\n' "$rc" >&2
  fi
  exit "$rc"
fi

if [ "${1:-}" = "__root" ]; then
  [ "$EUID" -eq 0 ] || { die 'Internal root dispatcher called without root privileges.'; exit 1; }
  shift
  case "${1:-}" in
    kernel-install) bc250_kernel_install;;
    umr-install) bc250_umr_install;;
    cu-install) bc250_cu_install;;
    *) die "Unknown internal setup action: ${1:-}"; exit 1;;
  esac
  exit $?
fi

bc250_ui_main "$@"
