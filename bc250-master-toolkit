#!/usr/bin/env bash
set -uo pipefail
VERSION="1.9.9"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for f in "$ROOT"/lib/hardware.sh "$ROOT"/lib/memory.sh "$ROOT"/lib/extras.sh "$ROOT"/lib/cu.sh "$ROOT"/lib/gpu_oc.sh; do [ -r "$f" ] && source "$f"; done
if [ -t 1 ] && [ "${NO_COLOR:-}" = "" ]; then
 C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_GREEN=$'\033[1;32m'; C_YELLOW=$'\033[1;33m'; C_RED=$'\033[1;31m'; C_CYAN=$'\033[1;36m'
else C_RESET=''; C_BOLD=''; C_GREEN=''; C_YELLOW=''; C_RED=''; C_CYAN=''; fi
center_line(){ local text="$1" width=64 len left right; len=${#text}; (( len > width )) && text=${text:0:width} && len=${#text}; left=$(( (width-len)/2 )); right=$(( width-len-left )); printf '║ %*s%s%*s ║\n' "$left" '' "$text" "$right" ''; }
banner(){ printf '\n'; printf '╔══════════════════════════════════════════════════════════════════╗\n'; center_line 'BC-250 MASTER TOOLKIT'; center_line 'CachyOS • validation-first workflow'; center_line "v${VERSION}"; printf '╚══════════════════════════════════════════════════════════════════╝\n\n'; }
ok(){ printf '%s[ OK ]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn(){ printf '%s[WARN]%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
info(){ printf '%s[INFO]%s %s\n' "$C_CYAN" "$C_RESET" "$*"; }
die(){ printf '%s[ERR ]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }
heading(){ printf '%s%s%s\n' "$C_BOLD" "$*" "$C_RESET"; }
need_root(){ [ "$EUID" -eq 0 ] || die 'This operation requires root. Run with sudo.'; }
preflight(){
 banner; heading '== 00 — PREFLIGHT (READ-ONLY) =='; echo
 local card bios kernel h; card=$(bc250_gpu_card 2>/dev/null || true); bios=$(bc250_bios); kernel=$(uname -r)
 [[ "$card" == card* ]] && ok 'AMD BC-250 detected (PCI 1002:13fe).' || die 'AMD BC-250 GPU was not detected.'
 h=$(bc250_hwmon "$card" 2>/dev/null || true)
 printf '\n  OS              : %s\n' "$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-Linux}")"; printf '  Kernel          : %s\n' "$kernel"; printf '  BIOS            : %s\n' "$bios"; printf '  CPU             : %sC / %sT\n' "$(bc250_cpu_cores)" "$(bc250_cpu_threads)"; printf '  CPU driver      : %s\n' "$(bc250_cpu_driver)"; printf '  CPU governor    : %s\n' "$(bc250_cpu_governor)"; printf '  GPU             : %s\n' "$card"; printf '  GPU SCLK        : %s MHz\n' "$(bc250_gpu_sclk "$h")"; printf '  GPU busy        : %s%%\n' "$(bc250_gpu_busy "$card")"; printf '  GPU temp        : %s°C\n' "$(bc250_gpu_temp "$h")"; printf '  CPU temp        : %s°C\n' "$(bc250_cpu_temp)"; printf '  VRM temp        : %s°C\n' "$(bc250_vrm_temp)"; echo
 bc250_bios_ok && ok 'BIOS P3.00 detected — BC-250 telemetry profile.' || warn "BIOS $bios — expected P3.00 telemetry profile."; bc250_kernel_ok && ok 'CachyOS BC-250 kernel detected.' || warn "Kernel $kernel does not contain the BC-250 marker."; command -v cpupower >/dev/null 2>&1 && ok 'cpupower available' || warn 'cpupower missing'; command -v vulkaninfo >/dev/null 2>&1 && ok 'vulkaninfo available' || warn 'vulkaninfo missing'; [ -x /usr/bin/cyan-skillfish-governor-smu ] && ok 'Cyan-Skillfish binary installed' || warn 'Cyan-Skillfish binary missing'; [ -f /etc/cyan-skillfish-governor-smu/config.toml ] && ok 'Cyan-Skillfish configuration present' || warn 'Cyan-Skillfish configuration missing'; bc250_governor_ok && ok 'GPU governor service active' || warn 'GPU governor service inactive'; bc250_telemetry_ok && ok 'GPU telemetry interfaces available' || warn 'GPU telemetry interfaces incomplete'; [ -r "/sys/class/drm/$card/device/pp_dpm_sclk" ] && ok 'GPU DPM interface available' || warn 'GPU DPM interface unavailable'; [ -r "/sys/class/drm/$card/device/mem_info_vram_total" ] && ok 'VRAM telemetry available' || warn 'VRAM telemetry unavailable'; [ -x /usr/local/bin/bc250-cu-live-manager ] && ok 'CU/WGP manager installed' || warn 'CU/WGP manager missing — run: sudo ./bc250-master-toolkit cu install'; }
status(){
 banner; heading 'Hardware'; local card h vr; card=$(bc250_gpu_card 2>/dev/null || true); printf '  BIOS                   %s\n' "$(bc250_bios)"; printf '  Kernel                 %s\n' "$(uname -r)"; printf '  CPU                    %sC / %sT\n' "$(bc250_cpu_cores)" "$(bc250_cpu_threads)"; printf '  CPU driver             %s\n' "$(bc250_cpu_driver)"; printf '  CPU governor           %s\n' "$(bc250_cpu_governor)"; printf '  GPU                    %s\n' "${card:-N/A}"; if [[ "$card" == card* ]]; then h=$(bc250_hwmon "$card" 2>/dev/null || true); vr=$(bc250_gpu_vram "$card"); printf '  GPU SCLK               %s MHz\n' "$(bc250_gpu_sclk "$h")"; printf '  GPU busy               %s%%\n' "$(bc250_gpu_busy "$card")"; printf '  GPU temp               %s°C\n' "$(bc250_gpu_temp "$h")"; printf '  VRAM                   %s MB / %s MB\n' "${vr% *}" "${vr#* }"; printf '  VRAM MCLK              %s MHz\n' "$(bc250_gpu_mclk "$h")"; fi; printf '  CPU temp               %s°C\n' "$(bc250_cpu_temp)"; printf '  VRM temp               %s°C\n' "$(bc250_vrm_temp)"; echo; bc250_bios_ok && ok 'BIOS: P3.00 telemetry profile' || warn 'BIOS: not the expected P3.00 telemetry profile'; bc250_kernel_ok && ok 'Kernel: CachyOS BC-250' || warn 'Kernel: BC-250 marker not detected'; bc250_governor_ok && ok 'GPU governor: Cyan-Skillfish SMU ACTIVE' || warn 'GPU governor: inactive'; [ -x /usr/local/bin/bc250-cu-live-manager ] && ok 'CU/WGP manager: installed' || warn 'CU/WGP manager: missing'; echo; extras_status_cmd; }
extras_status_cmd(){ banner; heading 'System extras'; bc250_extras_status; }
memory(){ banner; heading 'Memory / UMA status'; local x; x=$(bc250_memory_status); set -- $x; printf '  System RAM             %s MB\n' "$1"; printf '  Available RAM          %s MB\n' "$2"; printf '  GPU VRAM               %s/%s MB\n' "$3" "$4"; echo; heading 'Recommended UMA starting points:'; bc250_memory_recommendations; echo; info 'UMA_SIZE / RAM-VRAM split is configured in BIOS; toolkit does not modify it.'; }
cpu(){ banner; heading 'CPU / ACPI status'; printf '  Topology               %sC / %sT\n' "$(bc250_cpu_cores)" "$(bc250_cpu_threads)"; printf '  Driver                 %s\n' "$(bc250_cpu_driver)"; printf '  Governor               %s\n' "$(bc250_cpu_governor)"; printf '  CPU 0 current          %s MHz\n' "$(bc250_cpu_freq)"; printf '  CPU temperature        %s°C\n' "$(bc250_cpu_temp)"; printf '  VRM temperature        %s°C\n' "$(bc250_vrm_temp)"; echo; info 'CPU OC/UV remains intentionally deferred to the research phase.'; }
gpu_status(){
 banner; heading 'Cyan-Skillfish Governor SMU'; systemctl is-active --quiet cyan-skillfish-governor-smu.service && printf '  Service                : active\n' || printf '  Service                : inactive\n'; [ -f /etc/cyan-skillfish-governor-smu/config.toml ] && sed -n '/^fix-metrics\|^fix-freq\|^method\|^set-method/p' /etc/cyan-skillfish-governor-smu/config.toml | sed 's/^/  /'; local card h vr; card=$(bc250_gpu_card 2>/dev/null || true); if [[ "$card" == card* ]]; then h=$(bc250_hwmon "$card" 2>/dev/null || true); vr=$(bc250_gpu_vram "$card"); printf '  GPU SCLK               : %s MHz\n' "$(bc250_gpu_sclk "$h")"; printf '  GPU busy               : %s%%\n' "$(bc250_gpu_busy "$card")"; printf '  GPU temp               : %s°C\n' "$(bc250_gpu_temp "$h")"; printf '  VRAM                   : %s/%s MB\n' "${vr% *}" "${vr#* }"; printf '  VRAM MCLK              : %s MHz\n' "$(bc250_gpu_mclk "$h")"; printf '  CPU temp               : %s°C\n' "$(bc250_cpu_temp)"; printf '  VRM temp               : %s°C\n' "$(bc250_vrm_temp)"; echo; bc250_gpu_oc_status; fi; }
usage(){ cat <<EOF
BC-250 MASTER TOOLKIT v$VERSION
Usage: $0 <command>
  preflight              Validate BIOS, BC-250 kernel and telemetry path
  status                 Full hardware + extras status
  cpu                    CPU/ACPI telemetry
  gpu status             GPU governor + GPU/CPU/VRAM/VRM telemetry + range
  gpu oc profiles        List suggested GPU OC/UV starting points
  gpu oc status          Show active profile and governor range
  gpu oc apply <name>    Apply a selected GPU OC/UV profile
  gpu oc reset           Restore the pre-profile Cyan-Skillfish configuration
  memory                 Show current UMA split/VRAM and recommendations
  cu install             Download/install CU/WGP live manager
  cu umr install         Build/install official UMR from upstream source
  cu status              Show CU manager and UMR status
  extras status          Show swap/ZRAM/ZSWAP/bootloader state
  extras swap enable     Enable a swapfile (default 16G)
  extras zswap enable    Disable ZRAM and enable ZSWAP
  extras rdseed hide     Add loglevel=0 to the boot command line
EOF
}
cmd="${1:-preflight}"
case "$cmd" in
 preflight) preflight;; status) status;; cpu) cpu;; memory) memory;;
 gpu) case "${2:-status}" in status) gpu_status;; oc) case "${3:-profiles}" in profiles) bc250_gpu_oc_profiles;; status) bc250_gpu_oc_status;; apply) bc250_gpu_oc_apply "${4:-}";; reset) bc250_gpu_oc_reset;; *) die 'Use: gpu oc profiles | status | apply <name> | reset';; esac;; *) die 'unknown gpu command';; esac;;
 cu) case "${2:-status}" in status) bc250_cu_status;; install) need_root; bc250_cu_install;; umr) [ "${3:-}" = install ] || die 'Use: cu umr install'; need_root; bc250_umr_install;; *) die 'unknown cu command';; esac;;
 extras) case "${2:-status}" in status) extras_status_cmd;; swap) [ "${3:-}" = enable ] || die 'Use: extras swap enable [size]'; need_root; bc250_swap_enable "${4:-16G}";; zswap) [ "${3:-}" = enable ] || die 'Use: extras zswap enable'; need_root; bc250_zswap_enable;; rdseed) [ "${3:-}" = hide ] || die 'Use: extras rdseed hide'; need_root; bc250_rdseed_hide;; *) die 'unknown extras command';; esac;;
 help|-h|--help) usage;; *) die "unknown command: $cmd";;
esac
